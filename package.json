{
  "name": "national-ai-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SAYT,LAB\" -c \"cyan,magenta\" \"npm:dev:site\" \"npm:dev:lab\"",
    "dev:site": "npm --prefix frontend start",
    "dev:lab": "vite",
    "build": "vite build",
    "build:site": "cd frontend && CI=false npm run build",
    "preview": "vite preview",
    "build:all": "npm --prefix frontend install --no-audit --no-fund && CI=false npm --prefix frontend run build && vite build && node scripts/combine.mjs"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^10.0.4",
    "vite": "^5.4.10"
  }
}
