# ── National AI Lab · AI kalitlari ────────────────────────────────────────────
# Bu faylni nusxalang:  cp .env.example .env.local
# .env.local git'ga TUSHMAYDI.
#
# Kamida BITTA kalit kerak. Ikkitasi bo'lsa yaxshi: biri kunlik limitga
# yetsa, ilova avtomatik keyingisiga o'tadi.

# Groq — eng katta bepul limit (~14 000/kun). TAVSIYA ETILADI.
# https://console.groq.com
VITE_GROQ_KEY=

# Google Gemini — bepul, lekin kuniga ~20 so'rov
# https://aistudio.google.com/apikey
VITE_GEMINI_KEY=

# Ixtiyoriy zaxira
# https://cloud.cerebras.ai
VITE_CEREBRAS_KEY=
# https://openrouter.ai
VITE_OPENROUTER_KEY=

# ESLATMA: OpenAI kaliti brauzerdan ISHLAMAYDI (CORS bloklaydi).

# ── AI O'qituvchi ovozi ─────────────────────────────────────────────────
# VoiceLab — o'zbekcha tabiiy ovoz (voicelab.uz → API kalitlar, «vlk_...»).
# DIQQAT: oldida VITE_ YO'Q — kalit brauzerga chiqmaydi, faqat `npm run dev:lab`
# serveri orqali ishlatiladi. Kalit bo'lmasa: Gemini TTS, keyin brauzer ovozi.
VOICELAB_API_KEY=
# Ixtiyoriy: aniq ovoz ID si (bo'sh bo'lsa — birinchi o'zbekcha ovoz)
VOICELAB_VOICE_ID=
